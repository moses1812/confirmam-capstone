# ConfirmAm settings. Easiest way to create your real .env:   python -m scripts.make_env
# That command fills in strong random secrets for you. Never share or commit .env.

# development while building, production when you deploy (production refuses to start with weak settings)
APP_ENV=development
DATABASE_URL=sqlite:///./confirmam.db
# PostgreSQL example: postgresql+psycopg2://user:pass@localhost:5432/confirmam

# REQUIRED. Admin sign-in passcode, 10+ characters, not a common word. Empty = admin sign-in is disabled.
ADMIN_PASSCODE=
# REQUIRED. 32+ random characters, signs admin sessions. Empty = a temporary key is used and admin sessions end on every restart.
SECRET_KEY=
# OPTIONAL. 20+ random characters. Lets scripts or the /docs page call admin endpoints with header X-API-Key. Empty = off.
ADMIN_API_KEY=

# Which websites may call the API from a browser. * = any site. In production use your own address, e.g. https://confirmam.ng
CORS_ORIGINS=*
# Demo only: lets the admin API load fake sample reports. Keep false on a real site.
ENABLE_DEMO_SEED=false

# OPTIONAL threat-intel keys (a provider with no key is simply skipped; the app works fine without any)
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_KEY=
URLHAUS_AUTH_KEY=
IPQS_KEY=

FEED_REFRESH_HOURS=24
# Reported scam numbers from nigeriaphonebook.com (false = turn off, 0 hours = use the saved file only)
PHONE_LIST_ENABLED=true
PHONE_LIST_REFRESH_HOURS=12
